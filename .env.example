# Optional. Create your own key in Google AI Studio. Never commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Required for distributed AI usage limits in production. Local development
# uses a process-local limit when these are omitted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional local-only smoke testing. Do not enable for a public deployment.
LOCAL_AI_RATE_LIMIT=false
